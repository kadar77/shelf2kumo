rules_version = '2';

// Phase 0 baseline: deny everything. All application writes go through Cloud Functions (Admin SDK).
// Phase 1 adds owner-only reads of shops/{shopId}/** (spec §6 Authorization).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
