# Non-secret parameters for the production Firebase project shelf2kumo.
PUBLIC_ORIGIN=https://shelf2kumo.web.app
APP_CHECK_ENFORCE=true
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api
AMD_MODEL=MiniCPM-V-4.7-35B-A3B
# Observed 15–30 s per image (2026-10-15); keep headroom for multi-product photos.
AMD_REQUEST_TIMEOUT_MS=60000
# Chat planning models in fallback order (shared endpoint availability varies; 2026-10-15).
AMD_CHAT_MODELS=MiniCPM-V-4.7-35B-A3B,DeepSeek-V4.1-Flash,Qwen3.8-Flash-Next
AMD_CHAT_TIMEOUT_MS=30000
