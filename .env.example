# Copy to .env.local for local scripts. Never commit real values.
# In deployed Functions, AMD_API_KEY is provided via Firebase secret management.

# --- Server only (never prefix with VITE_) ---
AMD_API_KEY=
AMD_CHAT_COMPLETIONS_URL=https://developer.amd.com.cn/radeon/api/v1/chat/completions
AMD_MODEL=MiniCPM-V-4.7-35B-A3B
AMD_REQUEST_TIMEOUT_MS=45000
EXTRACTION_PROMPT_VERSION=extraction-v1
CHAT_PROMPT_VERSION=chat-v1

# --- Client (public Firebase web config; safe to expose) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_APP_CHECK_SITE_KEY=
VITE_USE_EMULATORS=true
