{
  "name": "shelf2kumo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @shelf2kumo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:secrets",
    "emulators": "pnpm build && firebase emulators:start --only functions,hosting",
    "emulators:all": "pnpm build && firebase emulators:start",
    "smoke:amd": "tsx --env-file-if-exists=.env.local scripts/amd-smoke.ts",
    "eval:images": "node scripts/render-test-images.mjs",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 tsx functions/scripts/seed-demo.ts",
    "test:emulator": "pnpm build && firebase emulators:exec --only auth,firestore,storage,functions,hosting --project demo-shelf2kumo 'pnpm --filter @shelf2kumo/tests test:emulator'",
    "deploy:prod": "firebase deploy --only firestore,storage,functions,hosting --project prod",
    "try:extraction": "tsx --env-file-if-exists=.env.local scripts/try-extraction.ts",
    "check:queries": "tsx functions/scripts/check-production-queries.ts",
    "try:chat": "tsx --env-file-if-exists=.env.local scripts/try-chat.ts",
    "ops:rollback": "tsx functions/scripts/rollback.ts",
    "test:e2e": "VITE_USE_EMULATORS=true pnpm build && firebase emulators:exec --only auth,firestore,storage,functions,hosting --project demo-shelf2kumo 'pnpm --filter @shelf2kumo/tests test:e2e'",
    "seed:demo": "tsx functions/scripts/seed-demo.ts",
    "ops:cleanup-test-data": "tsx functions/scripts/cleanup-test-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.34.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
