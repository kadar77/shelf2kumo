{
  "name": "shelf2kumo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @shelf2kumo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:secrets",
    "emulators": "pnpm build && firebase emulators:start --only functions,hosting",
    "emulators:all": "pnpm build && firebase emulators:start",
    "smoke:amd": "tsx --env-file-if-exists=.env.local scripts/amd-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
